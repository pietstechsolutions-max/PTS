<div class="card-head"><h1>Invoices</h1><a class="btn sm" href="/admin/invoices/new">+ New invoice</a></div>
<div class="card table-wrap"><table>
  <thead><tr><th>#</th><th>Client</th><th>Service date</th><th>Invoice date</th><th>Status</th><th class="num">Total</th><th class="num">Due</th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="7" class="muted">No invoices yet.</td></tr><% } %>
  <% for (const i of rows) { %><tr><td><a href="/admin/invoices/<%= i.id %>"><strong><%= i.number %></strong></a></td><td><a href="/admin/contacts/<%= i.contact_id %>"><%= i.first_name %> <%= i.last_name %></a></td><td><%= fmtDate(i.service_date) %></td><td><%= fmtDate(i.invoice_date) %></td><td><span class="badge <%= i.status %>"><%= i.status %></span></td><td class="num"><%= money(i.total_cents) %></td><td class="num"><%= money(i.total_cents - i.paid_cents) %></td></tr><% } %>
  </tbody>
</table></div>
