<div class="login-hero">
  <img src="/assets/brand/logo-lockup.png" alt="<%= business.name %>" onerror="this.onerror=null;this.src='/brand/logo-lockup.png'">
  <h1 style="margin-top:.75rem">Piets HQ</h1>
  <p class="muted">Back office sign in</p>
</div>
<div class="card">
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <% if (sandbox) { %><div class="notice warn small">Sandbox mode. Default login is <span class="mono">admin@pietstechsolutions.com / change-me</span> unless ADMIN_EMAIL / ADMIN_PASSWORD are set in <span class="mono">server/.env</span>.</div><% } %>
  <form method="post" action="/admin/login">
    <label>Email</label><input type="email" name="email" required autofocus autocomplete="username">
    <label>Password</label><input type="password" name="password" required autocomplete="current-password">
    <button class="btn big mt">Sign in</button>
  </form>
</div>
