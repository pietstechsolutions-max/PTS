<h1>Audit log</h1>
<p class="small muted">Every admin, client, webhook and automation action. Records are never deleted.</p>
<div class="card table-wrap"><table>
  <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
  <tbody><% for (const r of rows) { %><tr><td class="nowrap small"><%= fmtDateTime(r.created_at) %></td><td class="small"><%= r.actor %></td><td><%= r.action %></td><td class="small"><%= r.entity_type %><%= r.entity_id ? ' #' + r.entity_id : '' %></td><td class="small mono" style="max-width:420px;overflow-wrap:anywhere"><%= r.details %></td></tr><% } %></tbody>
</table></div>
