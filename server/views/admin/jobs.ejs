<div class="card-head"><h1>Jobs</h1><a class="btn sm" href="/admin/jobs/new">+ New job</a></div>
<div class="card table-wrap"><table>
  <thead><tr><th>#</th><th>Client</th><th>Title</th><th>Scheduled</th><th>Status</th><th>Invoice</th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="6" class="muted">No jobs. Approved estimates create jobs automatically.</td></tr><% } %>
  <% for (const j of rows) { %><tr><td><a href="/admin/jobs/<%= j.id %>"><strong>#<%= j.id %></strong></a></td><td><a href="/admin/contacts/<%= j.contact_id %>"><%= j.first_name %> <%= j.last_name %></a><%= j.town ? ' · ' + j.town : '' %></td><td><%= j.title %></td><td><%- j.scheduled_at ? fmtDateTime(j.scheduled_at) : '<span class="muted">not scheduled</span>' %></td><td><span class="badge <%= j.status.split(' ')[0] %>"><%= j.status %></span></td><td><% if (j.invoice_id) { %><a href="/admin/invoices/<%= j.invoice_id %>">Invoice</a><% } %></td></tr><% } %>
  </tbody>
</table></div>
