<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | <%= business.name %></title>
<link rel="icon" href="/assets/brand/favicon-64.png">
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
