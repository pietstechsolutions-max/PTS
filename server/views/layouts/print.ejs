<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | <%= business.name %></title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #0f1a33; margin: 0; padding: 24px; font-size: 14px; }
  .sheet { max-width: 820px; margin: 0 auto; }
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; border-bottom: 4px solid #011F5D; padding-bottom: 12px; }
  .head img { height: 64px; width: auto; }
  .head .biz { font-size: 13px; color: #334; margin-top: 6px; }
  .head .doc { text-align: right; }
  .head .doc .t { font-size: 26px; font-weight: 800; color: #011F5D; letter-spacing: .02em; }
  .head .doc .n { font-size: 18px; font-weight: 700; }
  .meta { display: flex; justify-content: space-between; gap: 16px; margin: 16px 0; flex-wrap: wrap; }
  .meta div { min-width: 200px; }
  .meta b { color: #011F5D; }
  table { width: 100%; border-collapse: collapse; margin-top: 8px; }
  th { text-align: left; background: #011F5D; color: #fff; padding: 8px; font-size: 12px; text-transform: uppercase; }
  td { padding: 8px; border-bottom: 1px solid #dbe3f0; vertical-align: top; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  .section { background: #e8f6ff; font-weight: 700; color: #011F5D; }
  .totals { width: 100%; max-width: 340px; margin-left: auto; margin-top: 8px; }
  .totals td { padding: 5px 8px; border: 0; }
  .totals tr.grand td { border-top: 2px solid #011F5D; font-size: 18px; font-weight: 800; color: #011F5D; }
  .box { border: 1.5px solid #02D7F5; border-radius: 8px; padding: 10px 12px; margin-top: 16px; background: #f4feff; }
  .foot { margin-top: 24px; font-size: 12px; color: #5b6a86; text-align: center; border-top: 1px solid #dbe3f0; padding-top: 10px; }
  .print-bar { text-align: center; margin-bottom: 12px; }
  .print-bar button, .print-bar a { font: inherit; padding: 8px 14px; border-radius: 8px; border: 2px solid #016FD6; background: #016FD6; color: #fff; font-weight: 700; text-decoration: none; cursor: pointer; margin: 0 4px; }
  @media print { .print-bar { display: none; } body { padding: 0; } }
</style>
</head>
<body>
<div class="sheet">
<div class="print-bar"><button onclick="window.print()">Print / Save as PDF</button> <a href="javascript:history.back()">Back</a></div>
<%- body %>
</div>
</body>
</html>
