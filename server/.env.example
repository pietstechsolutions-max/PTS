# ------------------------------------------------------------------
# Piets Technology Solutions - HQ server settings
# Copy this file to server/.env and fill in what you have.
# Anything you leave blank falls back to SANDBOX (mock) behaviour.
# ------------------------------------------------------------------

# Port the web server listens on. Render/Railway set this for you.
PORT=3000

# The public address of this server, no trailing slash. Used in links
# inside texts/emails (portal links, payment links) and for webhook checks.
# Local:  http://localhost:3000     Live: https://hq.pietstechsolutions.com
BASE_URL=http://localhost:3000

# Set to "production" on the live server (turns on secure cookies when BASE_URL is https).
NODE_ENV=development

# Long random string that signs login sessions. Change it before going live.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. On Render/Railway point this at a persistent disk.
DB_PATH=server/data/piets.db

# Force sandbox mode even if real keys are present (nothing is sent or charged).
SANDBOX=false

# Skip running `npm run build` (blog pre-render) at startup.
SKIP_BUILD=false
# Turn off the once-a-minute scheduler (automations, campaigns, overdue checks).
DISABLE_SCHEDULER=false

# --- Blog API -------------------------------------------------------------
# Secret token that lets a script (or an AI writer) publish blog posts via
# POST /api/blog with header "Authorization: Bearer <token>". Leave blank to disable the API.
BLOG_API_TOKEN=

# --- Zapier / API (Admin -> Integrations) ---------------------------------
# One master key for the REST API at <BASE_URL>/api/v1 (Zapier "Webhooks by Zapier",
# Make, n8n, scripts). Send it as the header  Authorization: Bearer <API_TOKEN>.
# You can ALSO create/revoke named keys in Admin -> Integrations, so this can stay blank.
# Generate one with:  node -e "console.log('pk_' + require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=
# How long (ms) to wait for an outbound webhook (Zapier Catch Hook etc.) before retrying. Default 10000.
WEBHOOK_TIMEOUT_MS=10000

# --- AI agents (Admin -> Integrations -> AI agents) ------------------------
# Leave every key blank and agents return a MOCK reply (logged to Admin -> Outbox -> AI).
# Anthropic: https://console.anthropic.com/settings/keys   (default model claude-sonnet-4-5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# OpenAI or any OpenAI-compatible server. For Ollama / LM Studio / vLLM on this machine set
# OPENAI_BASE_URL=http://localhost:11434/v1 (Ollama) and leave the key blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Admin login (Admin -> /admin) -------------------------------------
# If you leave these blank the server uses admin@pietstechsolutions.com / change-me
# and prints a warning at startup. ALWAYS set them on the live server.
ADMIN_EMAIL=admin@pietstechsolutions.com
ADMIN_PASSWORD=change-me

# --- Owner alerts --------------------------------------------------------
# Where "new lead", "estimate approved", "client replied" alerts are texted/emailed.
OWNER_PHONE=+16318715957
OWNER_EMAIL=pietstechsolutions@gmail.com

# --- Stripe (card payments + subscriptions) -----------------------------
# From https://dashboard.stripe.com/apikeys  (use sk_test_... first, then sk_live_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Developers -> Webhooks -> your endpoint -> "Signing secret" (whsec_...)
# Endpoint URL to add in Stripe:  <BASE_URL>/webhooks/stripe
# Events: checkout.session.completed, invoice.paid, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# --- Twilio (texting) ----------------------------------------------------
# From https://console.twilio.com  Account Info box.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in +1XXXXXXXXXX format.
TWILIO_PHONE_NUMBER=
# Optional: if you use a Messaging Service (recommended once A2P 10DLC is approved), its SID (MG...).
TWILIO_MESSAGING_SERVICE_SID=
# In Twilio, set the number's "A message comes in" webhook to:  <BASE_URL>/webhooks/twilio/sms  (HTTP POST)

# --- Email (SMTP) --------------------------------------------------------
# For Gmail: host smtp.gmail.com, port 587, user = your Gmail address,
# pass = an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Piets Technology Solutions <pietstechsolutions@gmail.com>"
